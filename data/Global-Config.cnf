# ===========================================================================
# === Stop Location =========================================================
# ===========================================================================
sl_distance; "euclidean_norm"
sl_radius; 100
sl_new_stop_default_name; "New_Stop_"
sl_model; "dsl"
#sl_model; "greedy"
#sl_model; "dsl-tt"
#sl_model; "dsl-tt-2"
#sl_model; "tt"
#sl_model; "all"
sl_acceleration; 0.7
sl_deceleration; 0.7
sl_waiting_time; 0
sl_walking_is_directed; false
sl_max_walking_time; -1
sl_max_walking_ratio; -1
sl_max_walking_amount; -1
sl_destruction_allowed; false
sl_eval_extended; false
sl_restricted_turns; false
sl_cost_of_stop; 100000
sl_solver; GUROBI
#sl_solver; XPRESS
#sl_solver; CPLEX
#sl_solver; SCIP
#sl_solver; GLPK
sl_timelimit; -1 # (-1 = no restriction)
sl_mip_gap; -1 # (-1 = no restriction)
sl_threads; -1 # (-1 = no restriction)
sl_write_lp_file; false
sl_forbidden_edges; false
#
# ===========================================================================
# === Line Pool Generation ==================================================
# ===========================================================================
lpool_model; "tree_based"
# lpool_model; "k_shortest_paths"
# lpool_model; "restricted_line_duration"
# lpool_model; "terminal-to-terminal"
# lpool_model; "center-periphery"
# lpool_model; "k_shortest_paths_waiting_times"
lpool_ratio_od; 0.3
lpool_add_shortest_paths; true
lpool_ratio_shortest_paths; 0.5
lpool_max_iterations; 5
lpool_costs_fixed; 50
lpool_costs_length; 0.05
lpool_costs_edges; 0.05
lpool_costs_vehicles; 0
lpool_min_edges; 5
lpool_min_distance_leaves; 15
lpool_node_degree_ratio; 0.3
lpool_min_cover_factor; 2
lpool_max_cover_factor; 3
lpool_number_shortest_paths; 1
lpool_coordinate_factor; 1
lpool_restricted_maximum_buffer_time; 10
lpool_restricted_allow_half_period; false
lpool_restrict_terminals; false
lpool_restrict_turns; false
lpool_append_single_edges; false
lpool_restrict_forbidden_edges; false
lpool_centers_fraction; 0.25
lpool_periphery_radius_factor; 1
lpool_direct_periphery_lines_factor; 0.1
lpool_center_radius_factor; 0.5
lpool_concatenate_lines_factor; 0.1
lpool_min_degree_center; 2
lpool_min_times_edge_covered; 3
lpool_max_iter_postprocessing; 100
lpool_opt_cost; false
lpool_plot_centers; false
#
lpool_adapt_method; trim_all
#lpool_adapt_method; trim_low_demand
#lpool_adapt_method; concatenate
lpool_nb_edges_to_trim; 1
lpool_trim_capacity_factor; 0.5
lpool_concatenate_keep_lines; false
lpool_concatenate_max_length; -1
lpool_draw_colored; true
#
# ===========================================================================
# === Multimodal Line Pool Generation =======================================
# ===========================================================================
# mm_lpool_od_aggregation; NONE
# mm_lpool_od_aggregation; USE_ISN
mm_lpool_od_aggregation; USE_MTG
# ===========================================================================
# === Ridepooling Pool Generation ===========================================
# ===========================================================================
#rpool_model; demand_heuristic
#rpool_model; tree_based
#rpool_model; all
#rpool_model; connected_subgraphs
rpool_model; node_based
#rpool_model; induced_subgraphs
rpool_write_stretch; false
rpool_induced_min_nodes; 2
rpool_induced_max_nodes; 5 # (-1 = no restriction)
rpool_load_factor; 2.86
rpool_costs_fixed; 5
rpool_min_edges; 1
rpool_max_edges; -1 # (-1 = no restriction)
rpool_compute_vehicle_frequencies; true
rpool_use_ptn_load; true
rpool_extend_existing_pool; false
rpool_respected_line_modality; line
rpool_draw_colored; true
rpool_draw_coordinate_factor; 1
# -----------------------------------------------------------------------------
# === PERIODIC EVENT ACTIVITY NETWORK CONSTRUCTION (ean_*) ====================
# === Use these settings to manipulate "make ptn2ean"      ====================
# -----------------------------------------------------------------------------
# Skip passenger distribution, raw event activity network
ean_construction_skip_passenger_distribution; false
# In program code please refer to ean_model_frequency instead!
